<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.Driftfin</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Driftfin</AssemblyName>
    <!-- Keep in sync with build.yaml; the release version is this minus the build field. -->
    <Version>1.0.2.0</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Target the Jellyfin server ABI you run; align with build.yaml's targetAbi. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.10.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
